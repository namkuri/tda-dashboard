# 인덱싱 옵션
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=8
GIT_CLONE_DIR=./repos
MAX_FILE_SIZE_KB=500  # 이보다 큰 파일은 청킹 스킵 (바이너리/미니파이 등)
