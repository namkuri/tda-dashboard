# ═══════════════════════════════════════════════════
# Deep Wiki 백엔드 환경 변수
# 이 파일을 .env로 복사하고 실제 값으로 채우세요.
# .env는 .gitignore에 포함되어 있어 commit되지 않습니다.
#
# ⚠ 절대 실제 키를 .env.example 에 적지 마세요.
#   placeholder만 쓰고 .env 에서 진짜 값을 관리하세요.
# ═══════════════════════════════════════════════════

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase Dashboard → Settings → API → service_role key
# 절대 GitHub에 commit 하지 마세요. .env 에서만 관리.
SUPABASE_SERVICE_KEY=REPLACE_WITH_YOUR_SERVICE_ROLE_KEY

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:14b
EMBED_MODEL=nomic-embed-text

# 서버
PORT=8000
CORS_ORIGINS=https://namkuri.github.io,http://localhost:3000

# 인덱싱 옵션
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=10
GIT_CLONE_DIR=./repos
MAX_FILE_SIZE_KB=4000
