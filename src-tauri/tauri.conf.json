{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TDA Dashboard",
  "version": "0.40.0",
  "identifier": "com.tda.dashboard",
  "build": {
    "frontendDist": "../public",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TDA Dashboard",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Team Dev Archive Dashboard",
    "longDescription": "Wiki & Task Management System for game development teams.",
    "copyright": "Copyright © 2026 TDA Team"
  }
}
