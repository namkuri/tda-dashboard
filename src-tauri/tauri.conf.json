{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TDA Dashboard",
  "version": "0.47.0",
  "identifier": "com.tda.dashboard",
  "build": {
    "frontendDist": "../public",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TDA Dashboard",
        "theme": "Dark",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["tda"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/namkuri/tda-dashboard/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4RDcxNUE3N0E2QTE4RTMKUldUakdHcDZweFhYT0tBaXBqc0dDVUU2OXlqRzFZZWpJaVBEb25JVEpaYys5ZlZXUzl5YjU3N2UK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Team Dev Archive Dashboard",
    "longDescription": "Wiki & Task Management System for game development teams.",
    "copyright": "Copyright © 2026 TDA Team"
  }
}
